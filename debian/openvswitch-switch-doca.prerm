#!/bin/sh

set -e

case "$1" in
    remove)
        update-alternatives --remove ovs-vswitchd /usr/lib/openvswitch-switch-doca/ovs-vswitchd-doca
        ;;

    deconfigure|upgrade|failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
